  <property name="windowTitle"><string>Chat · 会话</string></property>
  <property name="styleSheet">
   <string notr="true">#LogicDialog {
    background: #f3f4f9;
}
#rootFrame {
    background: #ffffff;
    border: 1px solid #e7e9f2;
    border-radius: 22px;
}
#sideBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #5f6ff2, stop:1 #7759e8);
    border-top-left-radius: 22px;
    border-bottom-left-radius: 22px;
}
#profileBadge {
    min-width: 44px;
    max-width: 44px;
    min-height: 44px;
    max-height: 44px;
    border-radius: 15px;
    background: rgba(255, 255, 255, 242);
    color: #685de9;
    font-size: 16px;
    font-weight: 700;
}
#messageNav, #contactNav, #favoriteNav, #settingsNav {
    min-width: 42px;
    max-width: 42px;
    min-height: 42px;
    max-height: 42px;
    border: none;
    border-radius: 14px;
    color: rgba(255, 255, 255, 199);
    background: transparent;
    font-size: 18px;
}
#messageNav {
    color: #665be7;
    background: rgba(255, 255, 255, 242);
}
#messageNav:hover, #contactNav:hover, #favoriteNav:hover, #settingsNav:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 43);
}
#conversationPanel {
    background: #fbfbfe;
    border-right: 1px solid #eceef4;
}
#conversationTitle {
    color: #1f2435;
    font-size: 22px;
    font-weight: 700;
}
#addConversationButton {
    min-width: 34px;
    max-width: 34px;
    min-height: 34px;
    max-height: 34px;
    border: 1px solid #e4e6ef;
    border-radius: 11px;
    color: #675de8;
    background: #ffffff;
    font-size: 18px;
}
#addConversationButton:hover {
    background: #f3f1ff;
    border-color: #d6d1ff;
}
#searchEdit {
    min-height: 38px;
    border: 1px solid #e7e9f1;
    border-radius: 12px;
    padding: 0 13px;
    color: #33384a;
    background: #f4f5f9;
    font-size: 12px;
}
#searchEdit:focus {
    border-color: #756bf0;
    background: #ffffff;
}
#conversationScroll {
    border: none;
    background: transparent;
}
#conversationScrollWidget {
    background: transparent;
}
#activeConversation {
    background: #efefff;
    border: 1px solid #e1defe;
    border-radius: 15px;
}
#conversationTwo, #conversationThree, #conversationFour, #conversationFive {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 15px;
}
#conversationTwo:hover, #conversationThree:hover, #conversationFour:hover, #conversationFive:hover {
    background: #f4f5fa;
}
#avatarOne, #avatarTwo, #avatarThree, #avatarFour, #avatarFive, #chatAvatar, #messageAvatarOne, #messageAvatarTwo {
    min-width: 42px;
    max-width: 42px;
    min-height: 42px;
    max-height: 42px;
    border-radius: 14px;
    color: #ffffff;
    font-size: 13px;
    font-weight: 700;
}
#avatarOne, #chatAvatar, #messageAvatarOne { background: #7569ef; }
#avatarTwo { background: #4ba9e8; }
#avatarThree { background: #f49a58; }
#avatarFour { background: #49b88c; }
#avatarFive { background: #dc6f95; }
#messageAvatarTwo { background: #4ba9e8; }
#conversationNameOne, #conversationNameTwo, #conversationNameThree, #conversationNameFour, #conversationNameFive {
    color: #292e3e;
    font-size: 13px;
    font-weight: 600;
}
#conversationPreviewOne, #conversationPreviewTwo, #conversationPreviewThree, #conversationPreviewFour, #conversationPreviewFive,
#conversationTimeOne, #conversationTimeTwo, #conversationTimeThree, #conversationTimeFour, #conversationTimeFive {
    color: #969daf;
    font-size: 10px;
}
#unreadBadge {
    min-width: 18px;
    max-width: 18px;
    min-height: 18px;
    max-height: 18px;
    border-radius: 9px;
    background: #6e63e9;
    color: #ffffff;
    font-size: 9px;
    font-weight: 700;
}
#chatPanel {
    background: #ffffff;
    border-top-right-radius: 22px;
    border-bottom-right-radius: 22px;
}
#chatHeader {
    background: #ffffff;
    border-bottom: 1px solid #eceef4;
    border-top-right-radius: 22px;
}
#chatName {
    color: #232838;
    font-size: 15px;
    font-weight: 700;
}
#chatStatus {
    color: #36a875;
    font-size: 10px;
}
#searchChatButton, #callButton, #videoButton, #moreButton {
    min-width: 34px;
    max-width: 34px;
    min-height: 34px;
    max-height: 34px;
    border: none;
    border-radius: 11px;
    background: transparent;
    color: #727a90;
    font-size: 16px;
}
#searchChatButton:hover, #callButton:hover, #videoButton:hover, #moreButton:hover {
    background: #f3f4f8;
    color: #5f56da;
}
#messageScroll {
    border: none;
    background: #fafbfe;
}
#messageScrollWidget {
    background: #fafbfe;
}
#dateLabel {
    color: #a1a7b7;
    font-size: 10px;
}
#incomingBubbleOne, #incomingBubbleTwo {
    background: #ffffff;
    border: 1px solid #eceef4;
    border-radius: 15px;
}
#outgoingBubbleOne, #outgoingBubbleTwo {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #5d7df5, stop:1 #8062e9);
    border: none;
    border-radius: 15px;
}
#incomingTextOne, #incomingTextTwo {
    color: #303547;
    font-size: 12px;
}
#outgoingTextOne, #outgoingTextTwo {
    color: #ffffff;
    font-size: 12px;
}
#incomingTimeOne, #incomingTimeTwo, #outgoingTimeOne, #outgoingTimeTwo {
    color: #a3a9b8;
    font-size: 9px;
}
#outgoingTimeOne, #outgoingTimeTwo {
    color: #858ca0;
}
#composerFrame {
    background: #ffffff;
    border-top: 1px solid #eceef4;
    border-bottom-right-radius: 22px;
}
#emojiButton, #imageButton, #fileButton {
    min-width: 32px;
    max-width: 32px;
    min-height: 32px;
    max-height: 32px;
    border: none;
    border-radius: 10px;
    background: transparent;
    color: #7b8296;
    font-size: 16px;
}
#emojiButton:hover, #imageButton:hover, #fileButton:hover {
    background: #f2f3f8;
    color: #6359df;
}
#messageEdit {
    border: 1px solid #e5e8f0;
    border-radius: 14px;
    padding: 10px 12px;
    background: #fafbfe;
    color: #2d3244;
    font-size: 12px;
}
#messageEdit:focus {
    border-color: #766bf0;
    background: #ffffff;
}
#sendButton {
    min-width: 78px;
    min-height: 40px;
    border: none;
    border-radius: 13px;
    color: #ffffff;
    font-size: 12px;
    font-weight: 700;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #527af3, stop:1 #855ee8);
}
#sendButton:hover {
    background: #665ae3;
}</string>
