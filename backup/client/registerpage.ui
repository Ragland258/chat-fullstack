<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>RegisterPage</class>
 <widget class="QWidget" name="RegisterPage">
  <property name="minimumSize"><size><width>0</width><height>0</height></size></property>
  <property name="styleSheet">
   <string notr="true">QWidget#RegisterPage {
    border: none;
    background: transparent;
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", sans-serif;
}
QPushButton#backButton {
    min-width: 32px;
    max-width: 32px;
    min-height: 32px;
    max-height: 32px;
    border: none;
    border-radius: 16px;
    background: transparent;
    color: #263246;
    font-size: 28px;
    font-weight: 300;
}
QPushButton#backButton:hover {
    background: rgba(22, 135, 248, 22);
    color: #0879ec;
}
QLabel#registerTitle {
    color: #1d2a3e;
    font-size: 21px;
    font-weight: 600;
}
QLabel#registerHint {
    color: #8a96a7;
    font-size: 12px;
}
QLineEdit#accountEdit,
QLineEdit#verifyCodeEdit,
QLineEdit#passwordEdit,
QLineEdit#confirmPasswordEdit {
    min-height: 46px;
    max-height: 46px;
    border: 1px solid #d7e0ea;
    border-radius: 11px;
    padding-left: 16px;
    padding-right: 14px;
    background: rgba(255, 255, 255, 242);
    color: #172033;
    selection-background-color: #1687f8;
    font-size: 15px;
}
QLineEdit#accountEdit:hover,
QLineEdit#verifyCodeEdit:hover,
QLineEdit#passwordEdit:hover,
QLineEdit#confirmPasswordEdit:hover {
    border-color: #b9cce1;
}
QLineEdit#accountEdit:focus,
QLineEdit#verifyCodeEdit:focus,
QLineEdit#passwordEdit:focus,
QLineEdit#confirmPasswordEdit:focus {
    border: 1px solid #278ef4;
    background: white;
}
QPushButton#getCodeButton {
    min-width: 102px;
    max-width: 102px;
    min-height: 46px;
    max-height: 46px;
    border: 1px solid #b7d8fb;
    border-radius: 11px;
    background: #eef7ff;
    color: #1687f8;
    font-size: 13px;
}
QPushButton#getCodeButton:hover {
    border-color: #1687f8;
    background: #e4f2ff;
}
QPushButton#getCodeButton:disabled {
    color: #9aa8b7;
    border-color: #dce3eb;
    background: #f3f5f8;
}
QPushButton#submitButton {
    min-height: 50px;
    max-height: 50px;
    border: none;
    border-radius: 12px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #1687f8,
                                stop:1 #0879ec);
    color: white;
    font-size: 19px;
    font-weight: 500;
}
QPushButton#submitButton:hover { background: #0878e7; }
QPushButton#submitButton:pressed { background: #0669cb; }
QPushButton#submitButton:disabled { background: #9dcaf5; color: rgba(255,255,255,190); }
QCheckBox#agreementBox {
    spacing: 8px;
    color: #667184;
    font-size: 13px;
}
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #b8c4d2;
    border-radius: 9px;
    background: white;
}
QCheckBox::indicator:hover { border-color: #1687f8; }
QCheckBox::indicator:checked { border-color: #1687f8; background: #1687f8; image: url(:/assets/check.png); }
QLabel#tipLabel {
    min-height: 22px;
    color: #df5964;
    font-size: 12px;
}
QLabel#noteLabel {
    color: #97a2b1;
    font-size: 11px;
}</string>
  </property>
