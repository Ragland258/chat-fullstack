  <property name="styleSheet">
   <string notr="true">QMainWindow, QWidget#centralwidget {
    background: transparent;
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", sans-serif;
}
QFrame#shellFrame {
    border: none;
    border-radius: 18px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #ffffff,
                                stop:0.56 #f8fbff,
                                stop:1 #edf5ff);
}
QWidget#titleBar, QWidget#loginPanel {
    border: none;
    background: transparent;
}
QPushButton#closeButton {
    min-width: 32px;
    max-width: 32px;
    min-height: 32px;
    max-height: 32px;
    border: none;
    border-radius: 8px;
    background: transparent;
    color: #657184;
    font-size: 21px;
    font-weight: 300;
}
QPushButton#closeButton:hover {
    color: #202735;
    background: rgba(32, 39, 53, 18);
}
QLabel#avatarBadge {
    min-width: 96px;
    max-width: 96px;
    min-height: 96px;
    max-height: 96px;
    border: 4px solid rgba(255, 255, 255, 245);
    border-radius: 50px;
    background: white;
}
QLineEdit#accountEdit, QLineEdit#passwordEdit {
    min-height: 50px;
    max-height: 50px;
    border: 1px solid #d7e0ea;
    border-radius: 12px;
    padding-left: 18px;
    padding-right: 18px;
    background: rgba(255, 255, 255, 242);
    color: #172033;
    selection-background-color: #1687f8;
    font-size: 16px;
}
QLineEdit#accountEdit:hover, QLineEdit#passwordEdit:hover {
    border-color: #b9cce1;
}
QLineEdit#accountEdit:focus, QLineEdit#passwordEdit:focus {
    border: 1px solid #278ef4;
    background: white;
}
QCheckBox#rememberBox, QCheckBox#agreementBox {
    spacing: 8px;
    color: #667184;
    font-size: 14px;
}
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #b8c4d2;
    border-radius: 9px;
    background: white;
}
QCheckBox::indicator:hover {
    border-color: #1687f8;
}
QCheckBox::indicator:checked {
    border-color: #1687f8;
    background: #1687f8;
    image: url(:/assets/check.png);
}
QPushButton#loginButton {
    min-height: 52px;
    max-height: 52px;
    border: none;
    border-radius: 12px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #1687f8,
                                stop:1 #0879ec);
    color: white;
    font-size: 20px;
    font-weight: 500;
}
QPushButton#loginButton:hover {
    background: #0878e7;
}
QPushButton#loginButton:pressed {
    background: #0669cb;
}
QPushButton#forgotButton, QPushButton#registerButton {
    min-height: 30px;
    border: none;
    background: transparent;
    color: #1687f8;
    font-size: 15px;
}
QPushButton#forgotButton:hover, QPushButton#registerButton:hover {
    color: #0567c6;
}
QLabel#orLabel, QLabel#linkSeparator {
    color: #a6b0bd;
    font-size: 14px;
}
QLabel#dividerLeft, QLabel#dividerRight {
    min-height: 1px;
    max-height: 1px;
    background: #dce3eb;
}
QStatusBar {
    min-height: 24px;
    max-height: 24px;
    border: none;
    background: transparent;
    color: #7a8699;
    font-size: 12px;
    padding-left: 14px;
}
QStatusBar::item { border: none; }</string>
